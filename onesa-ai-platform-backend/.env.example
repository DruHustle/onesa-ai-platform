ONESA_MODEL_API_KEY=REPLACE_IF_PROVIDER_REQUIRES
ONESA_EMBEDDING_BACKEND=lexical
ONESA_EMBEDDING_API_KEY=REPLACE_IF_PROVIDER_REQUIRES
