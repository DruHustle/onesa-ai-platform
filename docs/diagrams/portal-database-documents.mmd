erDiagram
  users {
    uuid id PK
    text email
    text password_hash
    text role
    text mfa_secret
    bigint mfa_last_step
    boolean disabled
    timestamptz created_at
    text mfa_pending
    text enroll_hash
    timestamptz enroll_expires
  }
  files {
    uuid id PK
    text filename
    text mime
    integer size
    text storage_key
    text sha256
    text classification
    text scan_status
    text approval
    integer version
    text title
    uuid owner_id FK
    timestamptz review_at
    text association
    timestamptz created_at
    uuid parent_id
    boolean archived
  }
  templates {
    text key PK
    text title
    text locale
    text body
    text status
    integer version
  }
  users ||--o{ files : "declared foreign key"
  files ||--o{ files : "declared foreign key"
