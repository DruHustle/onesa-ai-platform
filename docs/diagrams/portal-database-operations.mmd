%% Portal source schema SHA256: df7e3baafeaccdf70d1b409cf3788ba1cc777238c68e45f1679b8047decbaa93
erDiagram
  audit {
    bigint id PK "NOT NULL"
    uuid actor_id FK "nullable"
    text action "NOT NULL"
    text record_id "nullable"
    text request_id "nullable"
    timestamptz created_at "NOT NULL"
  }
  jobs {
    uuid id PK "NOT NULL"
    text kind "NOT NULL"
    text dedupe_key "NOT NULL"
    jsonb payload "NOT NULL"
    text status "NOT NULL"
    integer attempts "NOT NULL"
    timestamptz run_at "NOT NULL"
    timestamptz locked_at "nullable"
    text last_error "nullable"
    timestamptz created_at "NOT NULL"
  }
  operational_state {
    text key PK "NOT NULL"
    timestamptz updated_at "NOT NULL"
  }
  rate_limits {
    text key PK "NOT NULL"
    integer hits "NOT NULL"
    timestamptz expires_at "NOT NULL"
  }
  schema_migrations {
    text name PK "NOT NULL"
    text checksum "NOT NULL"
    timestamptz applied_at "nullable"
  }
  users {
    uuid id PK "NOT NULL"
  }
  users o|--o{ audit : "actor_id to id / NO ACTION"
