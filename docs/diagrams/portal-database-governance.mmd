%% Portal source schema SHA256: a24b83603dcc14456f61e5b037b98b821c13c9badd6d479ad08d346030f34c2f
erDiagram
  governance_events {
    bigint id PK "NOT NULL"
    text record_id FK "NOT NULL"
    integer revision FK "NOT NULL"
    uuid actor_id FK "nullable"
    text actor_email "nullable"
    text actor_role "nullable"
    text action "NOT NULL"
    text note "NOT NULL"
    text scope "NOT NULL"
    text[] evidence_refs "NOT NULL"
    text request_id "nullable"
    timestamptz created_at "NOT NULL"
  }
  governance_records {
    text stable_id PK,FK "NOT NULL"
    text kind "NOT NULL"
    text document_id FK "nullable"
    text classification "NOT NULL"
    integer current_revision FK "NOT NULL"
    integer effective_revision FK "nullable"
    boolean archived "NOT NULL"
    text seed_fingerprint "nullable"
    timestamptz created_at "NOT NULL"
    timestamptz updated_at "NOT NULL"
  }
  governance_versions {
    text record_id PK,FK "NOT NULL"
    integer revision PK "NOT NULL"
    text version_label "NOT NULL"
    text title "NOT NULL"
    text owner "NOT NULL"
    text[] product_scopes "NOT NULL"
    jsonb payload "NOT NULL"
    text[] evidence_refs "NOT NULL"
    text status "NOT NULL"
    text source_fingerprint "NOT NULL"
    text source_file "nullable"
    uuid created_by FK "nullable"
    timestamptz created_at "NOT NULL"
    timestamptz review_due_at "nullable"
    timestamptz effective_at "nullable"
    uuid approved_by FK "nullable"
    text approved_email "nullable"
    text approved_role "nullable"
    timestamptz approved_at "nullable"
    text approval_scope "nullable"
    text[] approval_evidence_refs "nullable"
  }
  users {
    uuid id PK "NOT NULL"
  }
  users o|--o{ governance_events : "actor_id to id / RESTRICT"
  governance_versions ||--o{ governance_events : "record_id,revision to record_id,revision / RESTRICT"
  governance_versions ||--o| governance_records : "stable_id,current_revision to record_id,revision / NO ACTION"
  governance_versions o|--o| governance_records : "stable_id,effective_revision to record_id,revision / NO ACTION"
  governance_records o|--o{ governance_records : "document_id to stable_id / RESTRICT"
  users o|--o{ governance_versions : "approved_by to id / RESTRICT"
  users o|--o{ governance_versions : "created_by to id / RESTRICT"
  governance_records ||--o{ governance_versions : "record_id to stable_id / RESTRICT"
