erDiagram
  agent_runs {
    UUID user_id FK
    VARCHAR goal
    VARCHAR_20_ status
    JSONB steps
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  auth_sessions {
    UUID user_id FK
    VARCHAR_64_ token_hash UK
    VARCHAR_64_ csrf_hash
    TIMESTAMP_WITH_TIME_ZONE expires_at
    TIMESTAMP_WITH_TIME_ZONE revoked_at
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  conversations {
    UUID user_id FK
    VARCHAR_200_ title
    VARCHAR_80_ selected_model_id
    TIMESTAMP_WITH_TIME_ZONE updated_at
    UUID active_run_id
    TIMESTAMP_WITH_TIME_ZONE lease_until
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  document_chunks {
    UUID document_id FK
    INTEGER position
    VARCHAR text
    VARCHAR_256_ embedding_version
    VECTOR_256_ embedding
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  documents {
    UUID user_id FK
    VARCHAR_200_ title
    VARCHAR_80_ media_type
    VARCHAR text
    VARCHAR_64_ checksum
    VARCHAR_256_ embedding_version
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  inference_runs {
    UUID request_id
    UUID user_id FK
    UUID conversation_id FK
    VARCHAR_80_ model_id
    VARCHAR_20_ status
    INTEGER latency_ms
    INTEGER input_tokens
    INTEGER output_tokens
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  messages {
    UUID conversation_id FK
    VARCHAR_20_ role
    JSONB content
    VARCHAR_20_ status
    INTEGER sequence
    VARCHAR_80_ model_id
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  rate_buckets {
    VARCHAR_64_ key PK
    INTEGER count
    TIMESTAMP_WITH_TIME_ZONE expires_at
  }
  trips {
    UUID user_id FK
    VARCHAR_200_ destination
    INTEGER duration
    FLOAT budget
    VARCHAR_3_ currency
    VARCHAR preferences
    INTEGER revision
    JSONB itinerary
    TIMESTAMP_WITH_TIME_ZONE updated_at
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  users {
    VARCHAR_254_ email UK
    VARCHAR_256_ password_hash
    VARCHAR_80_ display_name
    VARCHAR_20_ status
    TIMESTAMP_WITH_TIME_ZONE updated_at
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  users ||--o{ agent_runs : "user_id"
  users ||--o{ auth_sessions : "user_id"
  users ||--o{ conversations : "user_id"
  documents ||--o{ document_chunks : "document_id"
  users ||--o{ documents : "user_id"
  users ||--o{ inference_runs : "user_id"
  conversations ||--o{ inference_runs : "conversation_id"
  conversations ||--o{ messages : "conversation_id"
  users ||--o{ trips : "user_id"
