  users ||--o{ auth_sessions : "user_id"
  users ||--o{ bounded_uploads : "user_id"
  users ||--o{ conversations : "user_id"
  documents ||--o{ document_chunks : "document_id"
  users ||--o{ documents : "user_id"
  users ||--o{ identity_audit : "actor_id"
  identity_tokens ||--o{ identity_mail : "token_id"
  users ||--o{ identity_tokens : "user_id"
  users ||--o{ industrial_investigations : "user_id"
  users ||--o{ inference_runs : "user_id"
  conversations ||--o{ inference_runs : "conversation_id"
  conversations ||--o{ messages : "conversation_id"
  users ||--o{ model_leases : "user_id"
  users ||--o{ trips : "user_id"
  twin_templates ||--o{ twin_assets : "template_id"
  users ||--o{ twin_assets : "user_id"
  twin_assets ||--o{ twin_events : "asset_id"
  twin_sources ||--o{ twin_events : "source_id"
  twin_readings ||--o{ twin_events : "reading_id"
  users ||--o{ twin_files : "user_id"
  twin_templates ||--o{ twin_models : "template_id"
  twin_files ||--o{ twin_models : "file_id"
  users ||--o{ twin_models : "user_id"
  twin_assets ||--o{ twin_notes : "asset_id"
  users ||--o{ twin_notes : "user_id"
  twin_sources ||--o{ twin_readings : "source_id"
  twin_assets ||--o{ twin_readings : "asset_id"
  twin_assets ||--o{ twin_sources : "asset_id"
  users ||--o{ twin_sources : "user_id"
  users ||--o{ twin_templates : "user_id"
