erDiagram
  access_grants {
    UUID user_id PK
    TIMESTAMP_WITH_TIME_ZONE granted_at
    TIMESTAMP_WITH_TIME_ZONE expires_at
  }
  agent_runs {
    UUID user_id FK
    VARCHAR goal
    VARCHAR_20_ status
    JSONB steps
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  auth_sessions {
    UUID user_id FK
    VARCHAR_64_ token_hash UK
    VARCHAR_64_ csrf_hash
    TIMESTAMP_WITH_TIME_ZONE expires_at
    TIMESTAMP_WITH_TIME_ZONE revoked_at
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  bounded_uploads {
    UUID user_id FK
    VARCHAR_200_ filename
    VARCHAR_80_ media_type
    INTEGER size
    VARCHAR_64_ checksum
    INTEGER received
    TIMESTAMP_WITH_TIME_ZONE expires_at
    JSONB result
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  conversations {
    UUID user_id FK
    VARCHAR_200_ title
    VARCHAR_80_ selected_model_id
    TIMESTAMP_WITH_TIME_ZONE updated_at
    UUID active_run_id
    TIMESTAMP_WITH_TIME_ZONE lease_until
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  document_chunks {
    UUID document_id FK
    INTEGER position
    VARCHAR text
    VARCHAR_256_ embedding_version
    VECTOR_256_ embedding
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  documents {
    UUID user_id FK
    VARCHAR_200_ title
    VARCHAR_80_ media_type
    VARCHAR text
    VARCHAR_64_ checksum
    VARCHAR_256_ embedding_version
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  identity_audit {
    UUID actor_id FK
    VARCHAR_40_ event
    UUID record_id
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  identity_mail {
    UUID token_id PK
    VARCHAR_20_ state
    INTEGER attempts
    TIMESTAMP_WITH_TIME_ZONE next_attempt_at
    TIMESTAMP_WITH_TIME_ZONE lease_until
    UUID lease_id
    VARCHAR_200_ provider_id
  }
  identity_tokens {
    VARCHAR_20_ purpose
    VARCHAR_254_ email
    UUID user_id FK
    VARCHAR_64_ token_hash UK
    TIMESTAMP_WITH_TIME_ZONE expires_at
    TIMESTAMP_WITH_TIME_ZONE grant_expires_at
    TIMESTAMP_WITH_TIME_ZONE consumed_at
    TIMESTAMP_WITH_TIME_ZONE revoked_at
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  industrial_investigations {
    UUID user_id FK
    INTEGER revision
    VARCHAR_20_ status
    TIMESTAMP_WITH_TIME_ZONE updated_at
    JSONB payload
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  inference_runs {
    UUID request_id
    UUID user_id FK
    UUID conversation_id FK
    VARCHAR_80_ model_id
    VARCHAR_20_ status
    INTEGER latency_ms
    INTEGER input_tokens
    INTEGER output_tokens
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  messages {
    UUID conversation_id FK
    VARCHAR_20_ role
    JSONB content
    VARCHAR_20_ status
    INTEGER sequence
    VARCHAR_80_ model_id
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  model_leases {
    UUID user_id FK
    TIMESTAMP_WITH_TIME_ZONE expires_at
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  rate_buckets {
    VARCHAR_64_ key PK
    INTEGER count
    TIMESTAMP_WITH_TIME_ZONE expires_at
  }
  trips {
    UUID user_id FK
    VARCHAR_200_ destination
    INTEGER duration
    FLOAT budget
    VARCHAR_3_ currency
    VARCHAR preferences
    INTEGER revision
    JSONB itinerary
    TIMESTAMP_WITH_TIME_ZONE updated_at
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  twin_assets {
    UUID template_id FK
    VARCHAR_120_ name
    VARCHAR_120_ serial
    JSONB definition
    UUID active_model_id
    INTEGER revision
    TIMESTAMP_WITH_TIME_ZONE updated_at
    UUID user_id FK
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  twin_events {
    UUID asset_id FK
    UUID source_id FK
    UUID component_id
    UUID reading_id FK
    JSONB details
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  twin_files {
    VARCHAR_200_ filename
    VARCHAR_64_ sha256
    INTEGER size
    JSONB details
    UUID user_id FK
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  twin_models {
    UUID template_id FK
    UUID file_id FK
    JSONB definition
    UUID user_id FK
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  twin_notes {
    UUID asset_id FK
    UUID component_id
    VARCHAR_20_ kind
    JSONB payload
    UUID user_id FK
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  twin_readings {
    UUID source_id FK
    UUID asset_id FK
    UUID component_id
    VARCHAR_160_ message_id
    VARCHAR_80_ tag
    VARCHAR_16_ mode
    VARCHAR_24_ unit
    FLOAT value
    VARCHAR_16_ quality
    TIMESTAMP_WITH_TIME_ZONE observed_at
    JSONB provenance
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  twin_sources {
    UUID asset_id FK
    VARCHAR_120_ name
    VARCHAR_64_ token_hash UK
    JSONB definition
    TIMESTAMP_WITH_TIME_ZONE revoked_at
    TIMESTAMP_WITH_TIME_ZONE last_seen_at
    UUID user_id FK
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  twin_templates {
    VARCHAR_120_ name
    VARCHAR_80_ kind
    JSONB definition
    UUID user_id FK
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  upload_chunks {
    UUID upload_id PK
    INTEGER sequence PK
    BYTEA data
  }
  users {
    VARCHAR_254_ email UK
    VARCHAR_256_ password_hash
    VARCHAR_80_ display_name
    VARCHAR_20_ status
    TIMESTAMP_WITH_TIME_ZONE updated_at
    UUID id PK
    TIMESTAMP_WITH_TIME_ZONE created_at
  }
  users ||--o{ access_grants : "user_id"
