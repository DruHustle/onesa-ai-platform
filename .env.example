# Generate real local secrets with: python3 scripts/bootstrap_env.py
ONESA_DB_PASSWORD=replace-with-url-safe-random-password
ONESA_METRICS_TOKEN=replace-with-at-least-32-random-characters
ONESA_MODEL_API_KEY=replace-with-private-inference-key
ONESA_CHAT_PORT=3100
ONESA_PUBLIC_ORIGIN=http://localhost:3100
ONESA_SECURE_COOKIES=false
ONESA_MODEL_BACKEND=mock
ONESA_MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507
ONESA_MODEL_BASE_URL=http://inference:8000/v1
ONESA_MODEL_MAX_OUTPUT_TOKENS=1024
ONESA_MODEL_TEMPERATURE=0.7
ONESA_GENERATION_TIMEOUT=60
ONESA_EMBEDDING_BACKEND=lexical
ONESA_EMBEDDING_NAME=onesa-lexical-256-v1
ONESA_EMBEDDING_REVISION=1
# HTTP embedding providers must return exactly 256 finite dimensions.
ONESA_EMBEDDING_BASE_URL=http://embeddings:8000/v1
ONESA_EMBEDDING_API_KEY=
# For local API commands/tests only; Compose constructs its internal DB URL.
# ONESA_DATABASE_URL=postgresql+psycopg://onesa:password@127.0.0.1:55432/onesa_test
# GPU profile, after hardware/resource verification:
# ONESA_MODEL_CONTEXT_LENGTH=4096
# ONESA_GPU_MEMORY_UTILIZATION=0.85
# ONESA_TENSOR_PARALLEL_SIZE=1
# Production override requires ONESA_DOMAIN and real HTTPS.

# Interface catalog only; this does not assert model-language performance.
ONESA_UI_LOCALE=en

# Native macOS example (keep the serving daemon bound to 127.0.0.1):
# ONESA_MODEL_BACKEND=ollama
# ONESA_MODEL_NAME=qwen3:4b-instruct-2507-q4_K_M
# ONESA_MODEL_BASE_URL=http://host.docker.internal:11434/v1
# ONESA_MODEL_QUANTIZATION=Q4_K_M
# ONESA_MODEL_REVISION=<installed-model-digest>
# ONESA_MODEL_CONTEXT_LENGTH=8192

# Documentation defaults; internal authorization is deny-by-default.
# ONESA_DOCUMENTATION_ENGINEERING_USER_IDS=["authorized-existing-user-uuid"]
# NEXT_PUBLIC_ONESA_DOCUMENTATION_URL=http://localhost:3200
# NEXT_PUBLIC_ONESA_ENGINEERING_DOCUMENTATION_URL=http://localhost:3201

# Private runtime BFF URL; never use a NEXT_PUBLIC variable for backend/inference URLs.
ONESA_API_URL=http://api:8000
ONESA_ENVIRONMENT=development
ONESA_SESSION_HOURS=24
ONESA_AUTH_RATE_LIMIT=10
# Socket-peer protection supplements hashed account throttling behind private ingress.
ONESA_AUTH_PEER_RATE_LIMIT=100
ONESA_AUTH_HASH_CONCURRENCY=4
ONESA_KNOWLEDGE_UPLOAD_CONCURRENCY=1
# Production-only: ONESA_APP_DATABASE_URL and ONESA_DOMAIN must be supplied privately.
ONESA_PROXY_TIMEOUT_SECONDS=135

# Frontend only: enable after approved HTTPS domain verification (no includeSubDomains).
ONESA_HSTS_ENABLED=false

# Opt-in invitation pilot; this example does not enable or approve a release.
ONESA_REGISTRATION_MODE=invitation
ONESA_ACCESS_OPERATOR_USER_IDS=[]
# Persistent separate key (>=48 chars) for hashed invitation/recovery tokens; never paste it in chat.
ONESA_AUTH_DELIVERY_KEY=""
ONESA_MAIL_PROVIDER=disabled
ONESA_RESEND_API_KEY=""
ONESA_MAIL_FROM="Onesa AI <noreply@mail.onesa.eu>"
ONESA_MAIL_REPLY_TO=hello@onesa.eu
ONESA_RECOVERY_MINUTES=10
ONESA_INVITATION_HOURS=48
# Provisional shared engineering budgets; owner/capacity acceptance still required.
ONESA_MODEL_USER_CONCURRENCY=2
ONESA_MODEL_GLOBAL_CONCURRENCY=8
ONESA_MODEL_USER_REQUESTS_PER_MINUTE=20
ONESA_MODEL_GLOBAL_REQUESTS_PER_MINUTE=120
ONESA_MODEL_USER_RESERVED_TOKENS_PER_MINUTE=256000
ONESA_MODEL_GLOBAL_RESERVED_TOKENS_PER_MINUTE=1024000
ONESA_KNOWLEDGE_MAX_DOCUMENTS=100
ONESA_KNOWLEDGE_USER_TEXT_BYTES=16777216
ONESA_KNOWLEDGE_GLOBAL_TEXT_BYTES=268435456
