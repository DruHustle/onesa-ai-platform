{
  "name": "@onesa/ai-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=24.12 <25"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --no-install --template ./node_modules/expo/template.tgz",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "export": "expo export --platform all"
  },
  "dependencies": {
    "expo": "58.1.0",
    "expo-crypto": "58.0.9",
    "expo-secure-store": "58.0.3",
    "expo-system-ui": "58.0.7",
    "expo-web-browser": "58.1.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  }
}
