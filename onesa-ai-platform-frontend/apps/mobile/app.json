{
  "expo": {
    "name": "Onesa AI Platform",
    "slug": "onesa-ai-platform",
    "scheme": "onesaai",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "eu.onesa.aiplatform",
      "buildNumber": "1",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "eu.onesa.aiplatform",
      "versionCode": 1,
      "permissions": [],
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.CAMERA", "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE"]
    },
    "plugins": ["expo-secure-store", "expo-web-browser"],
    "updates": { "enabled": false }
  }
}
