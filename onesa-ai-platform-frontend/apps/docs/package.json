{
  "name": "onesa-docs",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "start": "node ../../../scripts/docs/public-dev.mjs",
    "build": "docusaurus build",
    "serve": "../../../.venv/bin/python ../../../scripts/docs/gateway.py",
    "typecheck": "tsc --noEmit",
    "render": "node ../../../scripts/docs/render.mjs",
    "verify": "node ../../../scripts/docs/verify.mjs",
    "build:public": "ONESA_DOCS_SCOPE=public docusaurus build --out-dir build-public",
    "build:internal": "ONESA_DOCS_SCOPE=internal docusaurus build --out-dir build-internal",
    "test:security": "node --test ../../../scripts/docs/security.test.cjs src/lib/application-origin.test.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "mermaid": "11.16.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "swagger-ui-react": "5.33.1",
    "@mermaid-js/layout-elk": "0.1.9",
    "braces": "file:vendor/onesa-braces-3.0.3-onesa.2.tgz",
    "sprintf-js": "file:vendor/onesa-sprintf-js-1.1.3-onesa.2.tgz"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "18.3.31",
    "@types/swagger-ui-react": "5.18.0",
    "typescript": "5.9.3",
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2",
    "markdown-it": "15.0.2",
    "@types/react-dom": "18.3.7"
  },
  "overrides": {
    "tinypool": "2.2.0",
    "serialize-javascript": "7.1.2",
    "katex": "0.19.0",
    "postcss-selector-parser": "^7.1.6",
    "lodash-es": "4.18.1",
    "uuid": "11.1.1",
    "braces": "$braces",
    "sprintf-js": "$sprintf-js"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
