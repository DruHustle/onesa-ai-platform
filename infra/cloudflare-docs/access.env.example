# Server-side Pages bindings; configure BOTH Production and Preview environments.
# Replace every example using the actual Access organization and application AUDs.
# These settings do not activate Access or prove the hosted policies are configured.
CF_ACCESS_TEAM_DOMAIN=replace-with-team.cloudflareaccess.com
CF_ACCESS_AUDIENCES='["replace-with-origin-aud","replace-with-preview-aud"]'
CF_ACCESS_ENGINEERING_EMAILS='["owner@example.invalid"]'
CF_ACCESS_ALLOWED_HOSTS='["onesa-engineering-docs.pages.dev","*.onesa-engineering-docs.pages.dev","docs.engineering.onesa.eu"]'
# The custom hostname must be an explicit destination of the existing canonical Access app.
# Preserve that app's audience, Portal identity provider, exact-email policy and sessions.
# Enter JSON arrays in the dashboard without the outer shell single quotes.
