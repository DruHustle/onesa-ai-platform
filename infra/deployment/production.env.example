# Reviewed target secrets are supplied by the operator; these placeholders are not credentials.
ONESA_ENVIRONMENT=production
ONESA_DOMAIN=example.invalid
ONESA_DB_PASSWORD=replace-with-url-safe-owner-password
ONESA_APP_DATABASE_URL=postgresql+psycopg://onesa_app:replace-with-app-password@db:5432/onesa
ONESA_METRICS_TOKEN=replace-with-at-least-32-random-characters
ONESA_API_URL=http://api:8000
ONESA_PUBLIC_ORIGIN=https://example.invalid
ONESA_SECURE_COOKIES=true
ONESA_MODEL_BACKEND=vllm
ONESA_MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507
ONESA_MODEL_BASE_URL=http://inference:8000/v1
ONESA_MODEL_API_KEY=replace-with-private-inference-key
ONESA_MODEL_CONTEXT_LENGTH=8192
ONESA_MODEL_MAX_OUTPUT_TOKENS=1024
ONESA_GENERATION_TIMEOUT=60
ONESA_SESSION_HOURS=24
ONESA_AUTH_RATE_LIMIT=10
ONESA_DB_MEMORY_LIMIT=2g
ONESA_API_MEMORY_LIMIT=1g
ONESA_FRONTEND_MEMORY_LIMIT=512m
NEXT_PUBLIC_ONESA_DOCUMENTATION_URL=https://docs.example.invalid
NEXT_PUBLIC_ONESA_ENGINEERING_DOCUMENTATION_URL=https://engineering.example.invalid

# Opt-in invitation pilot; this example does not enable or approve a release.
ONESA_REGISTRATION_MODE=invitation
ONESA_ACCESS_OPERATOR_USER_IDS=[]
# Persistent separate key (>=48 chars) for hashed invitation/recovery tokens; never paste it in chat.
ONESA_AUTH_DELIVERY_KEY=""
ONESA_MAIL_PROVIDER=disabled
ONESA_RESEND_API_KEY=""
ONESA_MAIL_FROM="Onesa AI <noreply@mail.onesa.eu>"
ONESA_MAIL_REPLY_TO=hello@onesa.eu
ONESA_RECOVERY_MINUTES=10
ONESA_INVITATION_HOURS=48
# Provisional shared engineering budgets; owner/capacity acceptance still required.
ONESA_MODEL_USER_CONCURRENCY=2
ONESA_MODEL_GLOBAL_CONCURRENCY=8
ONESA_MODEL_USER_REQUESTS_PER_MINUTE=20
ONESA_MODEL_GLOBAL_REQUESTS_PER_MINUTE=120
ONESA_MODEL_USER_RESERVED_TOKENS_PER_MINUTE=256000
ONESA_MODEL_GLOBAL_RESERVED_TOKENS_PER_MINUTE=1024000
ONESA_KNOWLEDGE_MAX_DOCUMENTS=100
ONESA_KNOWLEDGE_USER_TEXT_BYTES=16777216
ONESA_KNOWLEDGE_GLOBAL_TEXT_BYTES=268435456
