# Explicit isolated LOCAL synthetic rehearsal. Not a customer/production processing grant.
# Use the existing AI Compose/Docker architecture and a dedicated disposable database.
ONESA_ENVIRONMENT=development
ONESA_PUBLIC_ORIGIN=http://localhost:3139
ONESA_DATABASE_URL=postgresql+psycopg://PILOT_SYNTHETIC_USER:REPLACE_LOCALLY@127.0.0.1:55439/PILOT_SYNTHETIC_test
ONESA_MODEL_BACKEND=mock
ONESA_EMBEDDING_BACKEND=lexical
ONESA_MAIL_PROVIDER=disabled
ONESA_REGISTRATION_MODE=invitation
ONESA_ACCESS_OPERATOR_USER_IDS=[]
ONESA_INDUSTRIAL_DEMO_ENABLED=true
ONESA_INDUSTRIAL_IMPORT_ENABLED=true
# Hosted selected-provider qualification must use its separately approved existing
# provider, region, secrets and finite allowance. Never silently fall back to a provider.
# Individual invitations grant personal access only. No organisation/team sharing or SSO.
