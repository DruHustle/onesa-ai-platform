# STAGING ONLY. Blank REQUIRED values must be entered privately from real resources.
# Owner policy: free plans only. See docs/engineering/FREE_STAGING_SETUP.md.
# Do not replace an existing .env or deploy this incomplete file.
# RENDER staging API: isolated Neon resource onesa-ai-platform-backend-db-staging.
# Actual SQL database is neondb (resource label above is not the SQL database name).
# Owner-reported pooled host: ep-falling-thunder-b9x4ka3b-pooler.c-7.eu-central-1.aws.neon.tech
# ONESA_DATABASE_URL must use postgresql+psycopg:// with freshly rotated restricted-role
# credentials and preserve sslmode=require&channel_binding=require. No pasted owner password.
ONESA_ENVIRONMENT=staging
ONESA_SECURE_COOKIES=true
ONESA_DATABASE_URL=""
# REQUIRED exact assigned staging frontend origin, without a trailing slash/path.
ONESA_PUBLIC_ORIGIN=https://ai-staging.example.invalid
ONESA_METRICS_TOKEN=""
ONESA_REGISTRATION_MODE=invitation
ONESA_ACCESS_OPERATOR_USER_IDS=[]
ONESA_AUTH_HASH_CONCURRENCY=1
ONESA_KNOWLEDGE_UPLOAD_CONCURRENCY=1
ONESA_MODEL_USER_CONCURRENCY=1
ONESA_MODEL_GLOBAL_CONCURRENCY=1
ONESA_MODEL_CONTEXT_LENGTH=8192
ONESA_MODEL_MAX_OUTPUT_TOKENS=1024
ONESA_GENERATION_TIMEOUT=60
# Preserve existing adapter/model family; this does not create or expose an endpoint.
# Hosted inference remains BLOCKED. Do not use the Mac/localhost as a cloud endpoint.
ONESA_MODEL_BACKEND=ollama
ONESA_MODEL_NAME=qwen3:4b-instruct-2507-q4_K_M
ONESA_MODEL_BASE_URL=""
ONESA_MODEL_API_KEY=""
# Preserve the semantic candidate; do not silently substitute lexical/cloud vectors.
ONESA_EMBEDDING_BACKEND=http
ONESA_EMBEDDING_NAME=Qwen/Qwen3-Embedding-0.6B
ONESA_EMBEDDING_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3:qwen-retrieval-v1
ONESA_EMBEDDING_QUERY_INSTRUCTION=Given a user question, retrieve relevant document passages that answer the question
ONESA_EMBEDDING_BASE_URL=""
ONESA_EMBEDDING_API_KEY=""
# Enable Resend only after key rotation, private injection and approved recipient.
ONESA_MAIL_PROVIDER=disabled
ONESA_AUTH_DELIVERY_KEY=""
ONESA_RESEND_API_KEY=""
ONESA_MAIL_FROM=Onesa AI <noreply@mail.onesa.eu>
ONESA_MAIL_REPLY_TO=info@onesa.eu
# FRONTEND ONLY: copy into its project, not backend. No model/DB credentials here.
ONESA_API_URL=""
NEXT_PUBLIC_MAX_UPLOAD_BYTES=5242880
# MIGRATION PROCESS ONLY: use ONESA_DATABASE_URL with isolated migration-role URL.
# Runtime uses the separate restricted application-role URL under the same key.
