# Split these variables between the named provider projects; never commit a populated copy.
# Render API: restricted runtime DB role; migrate separately using the owner role.
ONESA_ENVIRONMENT=production
ONESA_SECURE_COOKIES=true
ONESA_DATABASE_URL=postgresql+psycopg://onesa_app:replace-password@replace-private-db/onesa
ONESA_PUBLIC_ORIGIN=https://platform.onesa.eu
ONESA_METRICS_TOKEN=replace-with-at-least-32-random-characters
ONESA_MODEL_BACKEND=ollama
ONESA_MODEL_NAME=replace-with-served-model-identifier
ONESA_MODEL_BASE_URL=https://replace-approved-inference.example.invalid/v1
ONESA_MODEL_API_KEY=replace-with-private-authentication-key
ONESA_EMBEDDING_BACKEND=lexical
# Vercel chat project only; server-side values, never NEXT_PUBLIC.
ONESA_API_URL=https://replace-approved-render-api.example.invalid
ONESA_HSTS_ENABLED=false
