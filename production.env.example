# AI PRODUCTION provider configuration; NOT a runnable release approval.
# Blank secrets/endpoints remain BLOCKED. Do not overwrite a private .env.
# RENDER API only; production DB must be separate from staging and Company Portal.
ONESA_ENVIRONMENT=production
ONESA_PUBLIC_ORIGIN=https://platform.onesa.eu
ONESA_SECURE_COOKIES=true
ONESA_DATABASE_URL=""
ONESA_METRICS_TOKEN=""
ONESA_REGISTRATION_MODE=invitation
ONESA_ACCESS_OPERATOR_USER_IDS=[]
ONESA_AUTH_HASH_CONCURRENCY=1
ONESA_KNOWLEDGE_UPLOAD_CONCURRENCY=1
ONESA_MODEL_USER_CONCURRENCY=1
ONESA_MODEL_GLOBAL_CONCURRENCY=1
ONESA_MODEL_CONTEXT_LENGTH=8192
ONESA_MODEL_MAX_OUTPUT_TOKENS=1024
ONESA_GENERATION_TIMEOUT=60
# Preserve the verified local model choice; no hosted Ollama URL currently exists.
# The vLLM HF checkpoint is a separate proposal, requiring compatibility acceptance.
ONESA_MODEL_BACKEND=ollama
ONESA_MODEL_NAME=qwen3:4b-instruct-2507-q4_K_M
ONESA_MODEL_BASE_URL=""
ONESA_MODEL_API_KEY=""
# Qualified local semantic candidate, not a provisioned production embedding service.
ONESA_EMBEDDING_BACKEND=http
ONESA_EMBEDDING_NAME=Qwen/Qwen3-Embedding-0.6B
ONESA_EMBEDDING_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3:qwen-retrieval-v1
ONESA_EMBEDDING_QUERY_INSTRUCTION=Given a user question, retrieve relevant document passages that answer the question
ONESA_EMBEDDING_BASE_URL=""
ONESA_EMBEDDING_API_KEY=""
ONESA_MAIL_PROVIDER=disabled
ONESA_AUTH_DELIVERY_KEY=""
ONESA_RESEND_API_KEY=""
ONESA_MAIL_FROM="Onesa AI <noreply@mail.onesa.eu>"
ONESA_MAIL_REPLY_TO=info@onesa.eu
# VERCEL AI project only, Production target, server-side; no /api or /v1 suffix.
# Actual service origin verified by authenticated Render inventory on 2026-10-10.
ONESA_API_URL=https://onesa-ai-platform-backend.onrender.com
ONESA_PROXY_TIMEOUT_SECONDS=135
NEXT_PUBLIC_ONESA_DOCUMENTATION_URL=https://docs.onesa.eu
NEXT_PUBLIC_MAX_UPLOAD_BYTES=5242880
ONESA_HSTS_ENABLED=false
# Migration process: same ONESA_DATABASE_URL key, independently injected owner-role URL.
# Runtime and identity worker use restricted application-role URLs.
